{
  "name": "pipeline_shell",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "video:preview": "hyperframes preview video",
    "video:check": "hyperframes check video --json",
    "video:snapshot": "hyperframes snapshot video",
    "video:render": "hyperframes render video --quality looks --output renders/video.mp4",
    "video:doctor": "hyperframes doctor",
    "otio": "uv run --project tools/otio python tools/otio/otio_cli.py",
    "otio:sync": "uv sync --project tools/otio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@ai-sdk/openai": "^4.0.121",
    "@ai-sdk/openai-compatible": "^3.0.93",
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "ai": "^7.0.177",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "hyperframes": "0.9.70",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@ts-morph/common": {
      "minimatch": "^11.0.1"
    }

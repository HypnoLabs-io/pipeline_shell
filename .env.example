# pipeline_shell environment. Copy to .env.local (git-ignored) and fill in what you use.
# Every integration is optional. A variable left blank or commented out turns its integration
# "off" on the status page. Set one only when the service is actually running, or that row
# shows "error".

# --- ComfyUI (local, unauthenticated HTTP API) ---
# COMFYUI_URL=http://127.0.0.1:8188

# --- LLMs (Vercel AI SDK provider registry; model ids are "<provider>:<model>") ---
# Ollama's OpenAI-compatible endpoint. Tags keep their colon: ollama:qwen3:14b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Hosted providers turn on only when their key is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any other OpenAI-compatible endpoint (OpenRouter, vLLM, LM Studio).
# OpenRouter: OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1  OPENAI_COMPAT_NAME=openrouter
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_NAME=compat
# Defaults used when a caller doesn't name a model. Use models your providers actually serve
# (for Ollama, `ollama pull <tag>` first). The vision model must accept images.
# LLM_MODEL=ollama:qwen3:14b
# VISION_MODEL=ollama:gemma4:26b

# --- ffmpeg (defaults to the binaries on PATH) ---
FFMPEG_PATH=
FFPROBE_PATH=

# --- DaVinci Resolve (Linux; the status page looks for it here, default /opt/resolve) ---
# RESOLVE_INSTALL_DIR=/opt/resolve
